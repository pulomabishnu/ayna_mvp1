{
  "name": "ethereal-apogee",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-sitemap.mjs && cross-env PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=1 vite build && node scripts/prerender.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "catalog:export": "node scripts/export-catalog.mjs",
    "catalog:check": "node scripts/export-catalog.mjs --check",
    "catalog:sql": "node scripts/export-catalog.mjs --brand",
    "catalog:sync": "node scripts/export-catalog.mjs --sync",
    "preview": "vite preview",
    "buyurls:update": "node scripts/update-product-buy-urls.mjs",
    "build:ios": "node scripts/check-posthog-key.mjs && npm run build && npx cap sync ios",
    "build:android": "node scripts/check-posthog-key.mjs && npm run build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capgo/capacitor-health": "^8.11.12",
    "@supabase/auth-js": "2.103.1",
    "@supabase/supabase-js": "^2.103.1",
    "@upstash/redis": "^1.37.0",
    "capacitor-ayna-cycle": "file:native/capacitor-ayna-cycle",
    "capacitor-ayna-records": "file:native/capacitor-ayna-records",
    "posthog-js": "^1.435.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stripe": "22.6.0",
    "twilio": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "puppeteer": "^24.38.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.9"
  }
}
