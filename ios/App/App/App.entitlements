<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- HealthKit read access for "Health data" (You -> Health data). No background
	     delivery. Nov 25: Clinical Health Records removed from 1.0 (App Review 2.1). -->
	<!-- Nov 16: phone notifications from the server (community, reminders). Without this iOS never hands the
	     app a push token, so device_tokens stayed empty. Push Notifications must also be on for the App ID. -->
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.healthkit</key>
	<true/>
	<!-- Nov 25: reminders she sets herself (medicines, products, plan) are Time Sensitive, so they come through
	     a Focus or Scheduled Summary. Nudges stay at the normal level (src/utils/localNotifications.js). -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
</dict>
</plist>
