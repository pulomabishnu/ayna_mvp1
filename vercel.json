{
  "installCommand": "PUPPETEER_SKIP_DOWNLOAD=true npm install",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/fda-recall?sweep=1",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/discover-products",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/discover-products",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/discover-products",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/send-emails?mode=instant",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/send-emails?mode=weekly",
      "schedule": "0 14 * * 0"
    },
    {
      "path": "/api/sms-reminders",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/campaign-notify",
      "schedule": "17 * * * *"
    },
    {
      "path": "/api/today-reminders?sweep=1",
      "schedule": "*/15 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://us.i.posthog.com https://us-assets.i.posthog.com; worker-src 'self' blob:; manifest-src 'self'; media-src 'self' https:"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/:page(today|ask|you|recommendations|comparison|omitted|recalls|tracked|screenings|appointment-prep|profile|text-ayna|delete-account|health-data|auth|confirmed|admin|internal|free-product|mobile-preview|wrapped|join|a)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/:page(today|ask|you|recommendations|comparison|omitted|recalls|tracked|screenings|appointment-prep|profile|text-ayna|delete-account|health-data|auth|confirmed|admin|internal|free-product|mobile-preview|wrapped|join|a)/:rest*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/community/:rest+",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/ecosystem",
      "has": [
        {
          "type": "query",
          "key": "view",
          "value": "dashboard"
        }
      ],
      "destination": "/today",
      "permanent": true
    },
    {
      "source": "/shop",
      "destination": "/explore/products",
      "permanent": true
    },
    {
      "source": "/discovery",
      "destination": "/explore/products",
      "permanent": true
    },
    {
      "source": "/library",
      "destination": "/explore/resources",
      "permanent": true
    },
    {
      "source": "/ecosystem",
      "destination": "/you/ecosystem",
      "permanent": true
    },
    {
      "source": "/my-ecosystem",
      "destination": "/you/ecosystem",
      "permanent": true
    },
    {
      "source": "/health",
      "destination": "/today",
      "permanent": true
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "aynahealth.co"
        }
      ],
      "destination": "https://www.aynahealth.co/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/a/:slug([A-Za-z0-9]{10})",
      "destination": "/api/share-answer?slug=:slug&format=html"
    },
    {
      "source": "/a/:rest*",
      "destination": "/index.html"
    },
    {
      "source": "/ingest/static/:path(.*)",
      "destination": "https://us-assets.i.posthog.com/static/:path"
    },
    {
      "source": "/ingest/:path(.*)",
      "destination": "https://us.i.posthog.com/:path"
    },
    {
      "source": "/:page(about|product|wrapped|admin|appointment-prep|auth|campus-resources|community|comparison|confirmed|consumer-health-data|contact|delete-account|discovery|explore|health|health-data|free-product|join|ecosystem|how-it-works|how-we-make-money|internal|library|mobile-preview|my-ecosystem|omitted|partner-brands|partners|privacy|privacy-policy|profile|quiz|recalls|recommendations|screenings|shop|startups|terms|terms-of-use|text-ayna|today|ask|tracked|you)",
      "destination": "/index.html"
    },
    {
      "source": "/:page(about|product|wrapped|admin|appointment-prep|auth|campus-resources|community|comparison|confirmed|consumer-health-data|contact|delete-account|discovery|explore|health|health-data|free-product|join|ecosystem|how-it-works|how-we-make-money|internal|library|mobile-preview|my-ecosystem|omitted|partner-brands|partners|privacy|privacy-policy|profile|quiz|recalls|recommendations|screenings|shop|startups|terms|terms-of-use|text-ayna|today|ask|tracked|you)/:rest*",
      "destination": "/index.html"
    }
  ]
}
