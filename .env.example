# Example environment variables. Never commit real secrets.

# See the project docs and deployment environment for the rest of the existing variables.
# Keep this file as the non-secret reference for required production configuration.

# Resend / campaign settings
CAMPAIGN_FROM_EMAIL=
# Physical mailing address required in marketing email footers (CAN-SPAM).
CAMPAIGN_POSTAL_ADDRESS=
# Who gets "someone claimed" and "ready to ship" emails (comma-separated).
# Unset: everyone in ADMIN_EMAILS. Needs only RESEND_API_KEY, not CAMPAIGN_EMAILS_ENABLED.
CAMPAIGN_TEAM_EMAIL=
SITE_URL=https://www.aynahealth.co

# ayna Pro Early Access billing.
# Turn billing/checkout on only after the Pro migration is applied and the
# production webhook + price configuration have been verified.
PRO_BILLING_ENABLED=
PRO_CHECKOUT_ENABLED=
STRIPE_RESTRICTED_KEY=
STRIPE_PRO_WEBHOOK_SECRET=
STRIPE_PRO_LIVEMODE=
STRIPE_PRO_PRODUCT_ID=
STRIPE_PRO_MONTH_PRICE_ID=
STRIPE_PRO_YEAR_PRICE_ID=
STRIPE_PRO_MONTH_RENEWAL_PRICE_ID=
STRIPE_PRO_YEAR_RENEWAL_PRICE_ID=
