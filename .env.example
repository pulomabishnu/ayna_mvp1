# Local scripts only (e.g. node update_images.cjs) — not used by the Vite app
SERPER_API_KEY=

# Resend — api/contact.js (the Contact form, both desktop's Contact.jsx and
# mobile's ProfileFlow.jsx ContactScreen post to this same endpoint). Without
# this set, the form fails closed with a clear 503 ("temporarily unavailable")
# rather than silently pretending to send. Get a key from resend.com; the
# sending domain (aynahealth.co) must be verified there first.
RESEND_API_KEY=
# Optional override — defaults to 'Ayna <puloma@aynahealth.co>' if unset.
CONTACT_FROM_EMAIL=

# Vercel / server: Project Settings → Environment Variables (never commit real keys)
# Used by api/product-insights.js (product modal → Load AI summaries & safe searches)

# At least one provider:

# Claude (Anthropic) — default order tries this first if the key is set:
ANTHROPIC_API_KEY=

# Gemini — your own API key from Google AI Studio (direct API, not Vercel):
GEMINI_API_KEY=
# GOOGLE_AI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_API_KEY=

# Optional: only if you use Vercel AI Gateway’s key (different from a Google Gemini key):
# GEMINI_AI_GATEWAY_API_KEY=
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
# AI_GATEWAY_GEMINI_MODEL=google/gemini-2.5-flash

OPENAI_API_KEY=

# Supabase client (used to store health intake by authenticated user id)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── PostHog Analytics ─────────────────────────────────────────────────────────
# Get the key from app.posthog.com → your project →
# Settings → Project → Project API Key
#
# Host: in production this MUST be left blank (or set to /ingest) — the app
# defaults to routing through vercel.json's first-party /ingest proxy rather
# than PostHog's own domain, because ad blockers (uBlock, Brave, Safari's
# tracking prevention) block *.posthog.com/*.i.posthog.com by domain and
# silently drop every event otherwise. See src/main.jsx for the fallback.
# The proxy only exists on Vercel, not the local `npm run dev` server, so for
# local dev only, point directly at PostHog's real domain instead:
#   US Cloud (default): https://us.i.posthog.com
#   EU Cloud: https://eu.i.posthog.com
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=

# Comma-separated PostHog distinct IDs for internal users (founders, developers, testers).
# Events from these IDs are tagged is_internal: true and excluded from PostHog analytics automatically.
# Works whether the user is logged in or anonymous.
#
# Current internal users — see src/utils/posthogInternal.js for the full,
# up-to-date list with context (this file just needs to match it):
# Puloma — phone:  019f23fa-2ddc-7baf-b219-bf4b5c6dceb4
# Puloma — laptop: 019f23fd-c46e-77a1-b38a-6198fa08a799
# Eliz   — phone:  019f23f6-e815-77bc-ae5f-ce0421ef345c
# Eliz   — laptop: (pending — add when known, no code change needed,
#                   just update this var and the Vercel env var and redeploy)
# Aditi (thakur.aditi0504@gmail.com): 78b66458-eb0e-4445-8e1a-8150c7db35aa
# lalaloops99@gmail.com:              46adced4-68e8-4a60-97ee-1fad4aa32135
# 3 anonymous pre-login IDs (2026-08-25, will need refreshing over time —
# see posthogInternal.js): 01a02d2f-4488-7fbf-acb3-67ccc38e8065,
# 01a02cb9-5061-7cb3-b910-67425fe5e71e, 01a0302d-a7ef-7e73-8a85-d8f4dc85f736
#
# To find a new distinct ID: visit the live site on the device, open browser console, run:
#   posthog.get_distinct_id()
# Copy the result and append it here comma-separated.
VITE_POSTHOG_INTERNAL_IDS=

# Optional provider order overrides. Production routes default to all three:
# anthropic,openai,gemini. Change these only if you intentionally want a different order.
# AI_INSIGHTS_PROVIDER_ORDER=anthropic,openai,gemini
# AI_RECOMMENDATIONS_PROVIDER_ORDER=anthropic,openai,gemini
# AI_DISCOVERY_PROVIDER_ORDER=anthropic,openai,gemini
# AI_SMS_PROVIDER_ORDER=anthropic,openai,gemini

# Optional model overrides
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# GEMINI_MODEL=gemini-2.0-flash

# api/llm-recommendations.js — AI-generated tiered recommendations from health intake (no catalog shortlist)
# Default provider order: anthropic,openai,gemini. Example Claude-only:
# AI_RECOMMENDATIONS_PROVIDER_ORDER=anthropic

# Supabase server-side (used by api/_usageLimit.js, phone verification, SMS
# webhook, api/notification-preferences.js, api/export-data.js — "Manage/
# Download my data")
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Airtable — scripts/sync-startups-from-airtable.mjs only (run manually, not
# at request time). Personal access token needs data.records:read scope and
# access to the "Early Stage Startups" base.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# Twilio — phone verification (self-issued OTP over plain SMS) + SMS webhook (api/sms-webhook.js)
# Works on a trial account: just needs a Twilio number, no Verify Service required.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Optional: send through a Messaging Service (A2P 10DLC) instead of a single number
TWILIO_MESSAGING_SERVICE_SID=
# Optional: sender used by reminders/recall SMS when different from TWILIO_PHONE_NUMBER
TWILIO_FROM_NUMBER=
# Optional: Twilio Verify service for OTP (see docs/twilio-sms.md)
TWILIO_VERIFY_SERVICE_SID=

# Frontend-visible copy of TWILIO_PHONE_NUMBER, shown in the UI ("Text Ayna at...")
VITE_AYNA_SMS_NUMBER=

# Recall-monitoring sweep (api/fda-recall.js?sweep=1, triggered daily by
# vercel.json's "crons" entry). Makes the "🔔 Monitor Safety Recalls" button
# actually notify tracked users by SMS when their product gets a new FDA recall.
#
# CRON_SECRET — required for the sweep to respond to anything at all (401
# otherwise). Vercel automatically sends `Authorization: Bearer $CRON_SECRET`
# when it invokes a scheduled cron job, if this var is set on the project —
# generate one with `openssl rand -hex 32`.
CRON_SECRET=

# RECALL_SWEEP_ENABLED — set to "1" to let the sweep actually send SMS and
# write state. Until then it runs in dry-run mode: it still checks every
# tracked product's recall status and logs what it WOULD do, but sends
# nothing and writes nothing (so flipping this on later doesn't miss a
# recall that occurred while dry-run was logging it).
RECALL_SWEEP_ENABLED=

# PRISM live tracing (api/_prismTrace.js) — one trace per LLM call from every
# /api route. Tracing is off unless PRISMTRACE_API_KEY is set. Real key goes in
# .env.local / Vercel env vars only, never here.
PRISMTRACE_API_KEY=
PRISMTRACE_PROJECT_ID=
PRISMTRACE_HOST=https://prism-api-prod.up.railway.app

# ── Connected health data (docs/wearables-ehr-integration.md) ──
# 32 bytes, hex (64 chars) or base64. Encrypts Oura and WHOOP OAuth tokens at rest.
# Without it, Oura and WHOOP stay switched off.
HEALTH_TOKEN_ENCRYPTION_KEY=
# Oura developer app (10-user cap until Oura approves it). Redirect URI to
# register: https://www.aynahealth.co/api/health-oauth-callback
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
# WHOOP developer app (developer-dashboard.whoop.com; 10 members until WHOOP
# approves a higher tier). Same redirect URI as Oura. Scopes: read:sleep
# read:recovery read:workout offline. WHOOP data is read live, never stored.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Optional override for the OAuth redirect host (preview deployments).
HEALTH_OAUTH_REDIRECT_BASE=
# Leave empty. Set to "anthropic" only after the founders/counsel approve
# sending health screenshots to Anthropic for reading.
HEALTH_IMAGE_EXTRACTION=
# ── Free product campaign (api/campaign*.js) ─────────────────────────────────
# Emails are OFF unless this is exactly "1" (and RESEND_API_KEY is set).
# Leave unset to never send anything; the page and claims still work.
CAMPAIGN_EMAILS_ENABLED=
CAMPAIGN_FROM_EMAIL=
# Physical mailing address required in marketing email footers (CAN-SPAM).
CAMPAIGN_POSTAL_ADDRESS=
# Who gets "someone claimed" and "ready to ship" emails (comma-separated).
# Unset: everyone in ADMIN_EMAILS. Needs only RESEND_API_KEY, not CAMPAIGN_EMAILS_ENABLED.
CAMPAIGN_TEAM_EMAIL=

# Admin access (api/_admin.js): comma-separated founder emails. Accounts must have a confirmed email.
ADMIN_EMAILS=
SITE_URL=https://www.aynahealth.co
